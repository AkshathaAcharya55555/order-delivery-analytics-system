# Local development configuration for docker-compose.yml.
#
# These are throwaway credentials for a local, single-machine sandbox stack
# (no real users, no network exposure) - NOT real secrets. Copy this file to
# .env (already in .gitignore, so your copy is never committed) and change
# the values if you want; docker-compose.yml falls back to the values shown
# here if no .env file is present at all, so `docker compose up` works with
# zero setup either way.

# --- PostgreSQL ---
POSTGRES_DB=oda_db
POSTGRES_USER=oda_user
POSTGRES_PASSWORD=oda_password

# --- Host ports (change here if any of these are already taken on your machine) ---
POSTGRES_PORT=5432
KAFKA_EXTERNAL_PORT=9092
REDIS_PORT=6379
ORDER_SERVICE_PORT=8081
DELIVERY_SERVICE_PORT=8082
TRACKING_SERVICE_PORT=8083
DASHBOARD_PORT=8501
